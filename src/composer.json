{
    "name": "ozitag/tager-backend",
    "type": "project",
    "description": "Tager Backend",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ozitag/tager-backend-admin": "^2.0",
        "ozitag/tager-backend-administrators": "^2.0",
        "ozitag/tager-backend-backup": "^2.0",
        "ozitag/tager-backend-core": "^2.1",
        "ozitag/tager-backend-cron": "^2.0",
        "ozitag/tager-backend-crud": "^2.1",
        "ozitag/tager-backend-fields": "^2.0",
        "ozitag/tager-backend-files": "^2.0",
        "ozitag/tager-backend-http-cache": "^2.0",
        "ozitag/tager-backend-mail": "^2.0",
        "ozitag/tager-backend-menus": "^2.0",
        "ozitag/tager-backend-pages": "^2.0",
        "ozitag/tager-backend-panel": "^2.0",
        "ozitag/tager-backend-rbac": "^2.0",
        "ozitag/tager-backend-sentry": "^2.0",
        "ozitag/tager-backend-seo": "^2.0",
        "ozitag/tager-backend-settings": "^2.0",
        "ozitag/tager-backend-utils": "^2.0",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^13.0",
        "spatie/laravel-ignition": "^2.12"
    }
}
