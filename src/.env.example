# Application
APP_NAME=Tager
APP_ENV=local
APP_DEBUG=true
APP_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=tager
DB_USERNAME=root
DB_PASSWORD=root

#sentry
SENTRY_LARAVEL_DSN=

TAGER_HTTP_CACHE=0

#queue
QUEUE_CONNECTION=sync

REDIS_HOST=redis

# Схема oauth_clients. true — ключ-UUID, который заводят миграции
# Passport 13 (так на любом новом проекте). false — целый ключ, оставшийся
# у всех, кто обновился с Passport <= 12.
PASSPORT_CLIENT_UUIDS=true

PASSPORT_PERSONAL_ACCESS_CLIENT_ID=
PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET=

RECAPTCHA_SERVER_KEY=
GOOGLE_AUTH_CLIENT_ID=

# Первый администратор. Задаются перед
#   php artisan db:seed --class=Database\\Seeders\\AdministratorSeeder
# Пакет больше не заводит администратора сам: до версии 2.0.3
# tager-backend-admin сеял учётку с паролем, лежавшим в его исходниках.
TAGER_ADMIN_NAME=Administrator
TAGER_ADMIN_EMAIL=
TAGER_ADMIN_PASSWORD=

# Получатели письма с формы обратной связи, через запятую
TAGER_MAIL_CONTACT_RECIPIENTS=

TAGER_MAIL_DEBUG=0
MAIL_MAILER=mailgun
MAIL_FROM_ADDRESS=info@ozitag.com
MAIL_FROM_NAME=TAGER

MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.eu.mailgun.net

TAGER_AUTOBACKUP_ENABLED=true
TAGER_AUTOBACKUP_ENCRYPT_PASSWORD=qwerty
AUTOBACKUP_SFTP_HOST=161.97.103.54
AUTOBACKUP_SFTP_USER=autobackup
